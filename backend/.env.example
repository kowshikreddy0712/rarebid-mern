PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/rarebid?replicaSet=rs0
# Optional: use when the system DNS resolver refuses MongoDB Atlas SRV lookups.
DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false
# Required only for npm run seed. Never use these development values in production.
ADMIN_NAME=RareBid Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Product images are stored locally for development. For production use private/object storage.
PUBLIC_API_URL=http://localhost:5000

# Optional SMTP configuration. Winner contact email is sent only when all values below are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RareBid <no-reply@example.com>

# Optional Razorpay test-mode payments. Use test keys until your integration is reviewed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
